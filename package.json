{
  "name": "nextrun",
  "version": "0.8.1",
  "private": true,
  "description": "Nextrun is a comprehensive running app built with Next.js, PostgreSQL, Drizzle ORM, and React",
  "keywords": [
    "nextjs",
    "postgresql",
    "drizzle",
    "auth",
    "react",
    "typescript",
    "stripe",
    "grammyjs"
  ],
  "homepage": "https://www.nextrun.dev",
  "bugs": {
    "url": "https://github.com/hamanovich/nextrun/issues",
    "email": "support@nextrun.dev"
  },
  "license": "MIT",
  "author": "Siarhei Hamanovich <support@nextrun.dev>",
  "scripts": {
    "bot:dev": "bun --watch run src/bot/index.ts",
    "build": "next build --turbopack",
    "bump:version": "node scripts/bump-version.js",
    "check": "bun run ts:check && bun run lint && bun run format:check && bun run test",
    "db:push": "drizzle-kit push",
    "dev": "next dev --turbopack",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint",
    "prepare": "husky",
    "start": "next start",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ts:check": "bunx tsc --noEmit --skipLibCheck"
  },
  "overrides": {
    "kysely": "0.28.17"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/files": "^1.2.0",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@hookform/resolvers": "^5.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-query": "^5.101.0",
    "better-auth": "^1.6.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "consola": "^3.4.2",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "grammy": "^1.44.0",
    "lucide-react": "^1.21.0",
    "motion": "^12.40.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "openai": "^6.44.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.79.0",
    "sonner": "^2.0.7",
    "stripe": "^22.2.2",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.17.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "trustedDependencies": [
    "@prisma/engines",
    "esbuild",
    "prisma",
    "sharp",
    "unrs-resolver"
  ]
}
