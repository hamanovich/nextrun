{
  "name": "nextrun",
  "version": "0.11.0",
  "private": true,
  "description": "Production-ready Next.js starter: Better Auth, Stripe credits, grammY Telegram bot, Drizzle on Neon Postgres, shadcn/ui",
  "keywords": [
    "nextjs",
    "postgresql",
    "drizzle",
    "auth",
    "react",
    "typescript",
    "stripe",
    "grammyjs"
  ],
  "homepage": "https://nextrun.hamanovich.com",
  "bugs": {
    "url": "https://github.com/hamanovich/nextrun/issues",
    "email": "nextrun@hamanovich.com"
  },
  "license": "MIT",
  "author": "Siarhei Hamanovich <nextrun@hamanovich.com>",
  "scripts": {
    "bot:dev": "bun --watch run src/bot/index.ts",
    "build": "next build --turbopack",
    "bump:version": "node scripts/bump-version.js",
    "check": "bun run ts:check && bun run lint && bun run format:check && bun run knip && bun run test",
    "db:push": "drizzle-kit push",
    "dev": "next dev --turbopack",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint",
    "prepare": "husky",
    "start": "next start",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ts:check": "bunx tsc --noEmit --skipLibCheck"
  },
  "overrides": {
    "kysely": "0.28.17"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/files": "^1.2.0",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@hookform/resolvers": "^5.9.2",
    "@neondatabase/serverless": "^1.2.0",
    "@tanstack/react-query": "^5.104.5",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "consola": "^3.4.2",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "grammy": "^1.46.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
